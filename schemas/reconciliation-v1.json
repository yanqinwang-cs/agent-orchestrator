{
  "$defs": {
    "ArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "relative_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        },
        "schema_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Schema Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_id",
        "content_hash"
      ],
      "title": "ArtifactEntry",
      "type": "object"
    },
    "AttemptStatus": {
      "enum": [
        "pending",
        "launching",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "outcome_unknown"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "FailureClass": {
      "enum": [
        "provider_transient",
        "tool_transient",
        "configuration",
        "policy",
        "timeout",
        "invalid_output",
        "worker_failure",
        "cancelled"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "OutputStatus": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ],
      "title": "OutputStatus",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "WorkerResult": {
      "additionalProperties": false,
      "description": "A normalized output envelope with provider receipt details.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactEntry"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "input_revision": {
          "minLength": 1,
          "title": "Input Revision",
          "type": "string"
        },
        "provider_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status"
        },
        "schema_id": {
          "const": "artifact-envelope-v1",
          "default": "artifact-envelope-v1",
          "title": "Schema Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OutputStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Revision"
        }
      },
      "required": [
        "attempt_id",
        "input_revision",
        "status",
        "summary"
      ],
      "title": "WorkerResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "effective_input_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective Input Revision"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "known": {
      "title": "Known",
      "type": "boolean"
    },
    "safe_to_retry": {
      "default": false,
      "title": "Safe To Retry",
      "type": "boolean"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "terminal_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "known"
  ],
  "title": "Reconciliation",
  "type": "object"
}
