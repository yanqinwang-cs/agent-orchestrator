{
  "$defs": {
    "ArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "minLength": 1,
          "title": "Content Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "relative_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        },
        "schema_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Schema Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_id",
        "content_hash"
      ],
      "title": "ArtifactEntry",
      "type": "object"
    },
    "OutputStatus": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ],
      "title": "OutputStatus",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "WorkerResult": {
      "additionalProperties": false,
      "description": "A normalized output envelope with provider receipt details.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactEntry"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "input_revision": {
          "minLength": 1,
          "title": "Input Revision",
          "type": "string"
        },
        "provider_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status"
        },
        "schema_id": {
          "const": "artifact-envelope-v1",
          "default": "artifact-envelope-v1",
          "title": "Schema Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OutputStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Revision"
        }
      },
      "required": [
        "attempt_id",
        "input_revision",
        "status",
        "summary"
      ],
      "title": "WorkerResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_hash": {
      "minLength": 1,
      "title": "Result Hash",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "validation_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Error"
    }
  },
  "required": [
    "result_hash",
    "recorded_at"
  ],
  "title": "AttemptResult",
  "type": "object"
}
