{
  "$defs": {
    "AttemptStatus": {
      "enum": [
        "pending",
        "launching",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "outcome_unknown"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "FailureClass": {
      "enum": [
        "provider_transient",
        "tool_transient",
        "configuration",
        "policy",
        "timeout",
        "invalid_output",
        "worker_failure",
        "cancelled"
      ],
      "title": "FailureClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "effective_input_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective Input Revision"
    },
    "error_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Summary"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "input_revision_uncertain": {
      "default": false,
      "title": "Input Revision Uncertain",
      "type": "boolean"
    },
    "receipt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Id"
    },
    "retry_authorized": {
      "default": false,
      "title": "Retry Authorized",
      "type": "boolean"
    },
    "safe_to_retry": {
      "default": false,
      "title": "Safe To Retry",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/AttemptStatus"
    },
    "worker_backend_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Backend Version"
    },
    "worker_handle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Handle Id"
    },
    "worker_lifecycle_owner_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Lifecycle Owner Id"
    },
    "worker_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Session Id"
    },
    "worker_thread_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Thread Id"
    },
    "worker_turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Turn Id"
    }
  },
  "required": [
    "attempt_id",
    "status"
  ],
  "title": "AttemptState",
  "type": "object"
}
