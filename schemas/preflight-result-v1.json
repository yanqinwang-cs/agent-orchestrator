{
  "$defs": {
    "PreflightIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "setting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setting"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PreflightIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/PreflightIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "accepted"
  ],
  "title": "PreflightResult",
  "type": "object"
}
