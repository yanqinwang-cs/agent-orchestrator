{
  "$defs": {
    "ControlDelivery": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "attempted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempted At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "effective_input_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Input Revision"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ControlDeliveryStatus"
        },
        "worker_handle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Handle Id"
        },
        "worker_thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Thread Id"
        },
        "worker_turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Turn Id"
        }
      },
      "required": [
        "action_id",
        "attempt_id",
        "status",
        "requested_at"
      ],
      "title": "ControlDelivery",
      "type": "object"
    },
    "ControlDeliveryStatus": {
      "enum": [
        "not_required",
        "pending",
        "delivering",
        "acknowledged",
        "rejected",
        "unsupported",
        "failed",
        "unknown"
      ],
      "title": "ControlDeliveryStatus",
      "type": "string"
    },
    "InterventionKind": {
      "enum": [
        "pause",
        "resume",
        "stop",
        "stop_attempt",
        "steer",
        "retry",
        "redirect"
      ],
      "title": "InterventionKind",
      "type": "string"
    },
    "InterventionTargetScope": {
      "enum": [
        "run",
        "stage",
        "attempt"
      ],
      "title": "InterventionTargetScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Inspectable, versioned lifecycle state for one accepted or rejected command.",
  "properties": {
    "actor": {
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "deliveries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ControlDelivery"
      },
      "title": "Deliveries",
      "type": "array"
    },
    "delivery_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControlDeliveryStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_run_revision": {
      "minimum": 0,
      "title": "Expected Run Revision",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/InterventionKind"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "resulting_attempt_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resulting Attempt Revision"
    },
    "resulting_run_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resulting Run Revision"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_id": {
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_scope": {
      "$ref": "#/$defs/InterventionTargetScope"
    },
    "validation_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Detail"
    },
    "validation_outcome": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Validation Outcome",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "run_id",
    "actor",
    "target_scope",
    "target_id",
    "expected_run_revision",
    "kind",
    "payload",
    "requested_at",
    "validation_outcome"
  ],
  "title": "InterventionRecord",
  "type": "object"
}
