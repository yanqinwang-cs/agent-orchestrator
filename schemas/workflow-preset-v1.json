{
  "$defs": {
    "ApprovalMode": {
      "enum": [
        "deny_all"
      ],
      "title": "ApprovalMode",
      "type": "string"
    },
    "CalibrationIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "content_hash"
      ],
      "title": "CalibrationIdentity",
      "type": "object"
    },
    "Condition": {
      "enum": [
        "always",
        "repair_needed",
        "repair_not_needed"
      ],
      "title": "Condition",
      "type": "string"
    },
    "DecisionAcceptancePolicy": {
      "additionalProperties": false,
      "description": "Deterministic rules for consuming a normalized decision result.",
      "properties": {
        "fallback_outcome_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Outcome Id"
        },
        "minimum_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Score"
        },
        "mode": {
          "enum": [
            "typed_outcome",
            "score_threshold"
          ],
          "title": "Mode",
          "type": "string"
        },
        "on_abstention": {
          "default": "attention_required",
          "enum": [
            "fallback",
            "attention_required"
          ],
          "title": "On Abstention",
          "type": "string"
        },
        "on_engine_failure": {
          "default": "attention_required",
          "enum": [
            "fallback",
            "attention_required"
          ],
          "title": "On Engine Failure",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "required_calibration": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_score_scale": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Score Scale"
        },
        "required_score_semantics": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Score Semantics"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "understood_score_semantics": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Understood Score Semantics",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "mode"
      ],
      "title": "DecisionAcceptancePolicy",
      "type": "object"
    },
    "DecisionEvidenceRequirement": {
      "additionalProperties": false,
      "description": "A narrow, authored source reference for evidence required by a question.",
      "properties": {
        "inclusion_reason": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Inclusion Reason",
          "type": "string"
        },
        "kind": {
          "enum": [
            "run_task",
            "stage_output"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output_name": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Name"
        },
        "stage_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Id"
        }
      },
      "required": [
        "kind",
        "inclusion_reason"
      ],
      "title": "DecisionEvidenceRequirement",
      "type": "object"
    },
    "DecisionInferenceBinding": {
      "additionalProperties": false,
      "description": "Frozen identity for one inference mechanism, without provider SDK objects.",
      "properties": {
        "adapter_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Id"
        },
        "adapter_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Revision"
        },
        "base_model_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Model Id"
        },
        "base_model_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Model Revision"
        },
        "calibration": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_model_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Model Id"
        },
        "decision_model_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Model Revision"
        },
        "deterministic_policy_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deterministic Policy Id"
        },
        "deterministic_policy_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deterministic Policy Revision"
        },
        "deterministic_rule": {
          "anyOf": [
            {
              "const": "first_allowed",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deterministic Rule"
        },
        "inference_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceStateIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanism": {
          "$ref": "#/$defs/DecisionMechanism"
        },
        "readout_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readout Id"
        },
        "readout_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readout Revision"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "mechanism"
      ],
      "title": "DecisionInferenceBinding",
      "type": "object"
    },
    "DecisionMechanism": {
      "enum": [
        "deterministic_policy",
        "native_decision_model",
        "general_llm_readout",
        "generative_structured_output"
      ],
      "title": "DecisionMechanism",
      "type": "string"
    },
    "DecisionQuestionConfig": {
      "additionalProperties": false,
      "description": "Authored bounded decision configuration stored in a workflow policy.",
      "properties": {
        "acceptance_policy": {
          "$ref": "#/$defs/DecisionAcceptancePolicy"
        },
        "action": {
          "const": "redirect_select_one",
          "default": "redirect_select_one",
          "title": "Action",
          "type": "string"
        },
        "evidence_requirements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DecisionEvidenceRequirement"
          },
          "maxItems": 16,
          "title": "Evidence Requirements",
          "type": "array"
        },
        "inference_binding": {
          "$ref": "#/$defs/DecisionInferenceBinding"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "question_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Question Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stage_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Stage Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "revision",
        "stage_id",
        "question",
        "inference_binding",
        "acceptance_policy"
      ],
      "title": "DecisionQuestionConfig",
      "type": "object"
    },
    "InferenceStateIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "state_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "revision",
        "content_hash"
      ],
      "title": "InferenceStateIdentity",
      "type": "object"
    },
    "OrchestratorPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_count_selection": {
          "default": false,
          "title": "Allow Count Selection",
          "type": "boolean"
        },
        "allow_new_profiles": {
          "default": false,
          "title": "Allow New Profiles",
          "type": "boolean"
        },
        "allow_optional_skip": {
          "default": false,
          "title": "Allow Optional Skip",
          "type": "boolean"
        },
        "allow_permission_expansion": {
          "default": false,
          "title": "Allow Permission Expansion",
          "type": "boolean"
        },
        "allow_profile_selection": {
          "default": false,
          "title": "Allow Profile Selection",
          "type": "boolean"
        },
        "allow_required_stage_removal": {
          "default": false,
          "title": "Allow Required Stage Removal",
          "type": "boolean"
        },
        "allow_retry": {
          "default": true,
          "title": "Allow Retry",
          "type": "boolean"
        },
        "allowed_backends": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Allowed Backends",
          "type": "array"
        },
        "allowed_model_bindings": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Allowed Model Bindings",
          "type": "array"
        },
        "decision_questions": {
          "items": {
            "$ref": "#/$defs/DecisionQuestionConfig"
          },
          "title": "Decision Questions",
          "type": "array"
        },
        "permission_ceiling": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "allowed_backends",
        "allowed_model_bindings"
      ],
      "title": "OrchestratorPolicy",
      "type": "object"
    },
    "PermissionSet": {
      "additionalProperties": false,
      "description": "Requested worker permissions; tool lists remain intentions, not enforcement.",
      "properties": {
        "approval_mode": {
          "$ref": "#/$defs/ApprovalMode",
          "default": "deny_all"
        },
        "external_integrations": {
          "default": false,
          "title": "External Integrations",
          "type": "boolean"
        },
        "nested_agents": {
          "default": false,
          "title": "Nested Agents",
          "type": "boolean"
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxMode"
        },
        "shell_network": {
          "default": false,
          "title": "Shell Network",
          "type": "boolean"
        },
        "web_search": {
          "default": false,
          "title": "Web Search",
          "type": "boolean"
        }
      },
      "required": [
        "sandbox"
      ],
      "title": "PermissionSet",
      "type": "object"
    },
    "RedirectRule": {
      "additionalProperties": false,
      "properties": {
        "allowed_profiles": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Allowed Profiles",
          "type": "array"
        },
        "stage": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "allowed_profiles"
      ],
      "title": "RedirectRule",
      "type": "object"
    },
    "SandboxMode": {
      "enum": [
        "read-only",
        "workspace-write"
      ],
      "title": "SandboxMode",
      "type": "string"
    },
    "SlotKind": {
      "enum": [
        "fixed",
        "select_one",
        "elastic"
      ],
      "title": "SlotKind",
      "type": "string"
    },
    "StageCompletion": {
      "enum": [
        "artifact_ready",
        "report_present",
        "report_passed",
        "integration_succeeded",
        "decision_recorded"
      ],
      "title": "StageCompletion",
      "type": "string"
    },
    "StageKind": {
      "enum": [
        "worker",
        "integrate",
        "integration_check",
        "repair_gate"
      ],
      "title": "StageKind",
      "type": "string"
    },
    "WorkflowCompletion": {
      "enum": [
        "reports_present",
        "validated_prototype",
        "verified_revision",
        "verified_research"
      ],
      "title": "WorkflowCompletion",
      "type": "string"
    },
    "WorkflowStage": {
      "additionalProperties": false,
      "properties": {
        "allowed_profiles": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Allowed Profiles",
          "type": "array"
        },
        "completion": {
          "$ref": "#/$defs/StageCompletion"
        },
        "default_profile": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Profile"
        },
        "depends_on": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StageKind"
        },
        "max_workers": {
          "anyOf": [
            {
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Workers"
        },
        "min_workers": {
          "anyOf": [
            {
              "maximum": 32,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Workers"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "parallel_group": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel Group"
        },
        "required_outputs": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Required Outputs",
          "type": "array"
        },
        "slot_briefs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Slot Briefs",
          "type": "array"
        },
        "slot_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "$ref": "#/$defs/Condition",
          "default": "always"
        }
      },
      "required": [
        "id",
        "kind",
        "required_outputs",
        "completion"
      ],
      "title": "WorkflowStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_profiles": {
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "Allowed Profiles",
      "type": "array"
    },
    "allowed_redirects": {
      "items": {
        "$ref": "#/$defs/RedirectRule"
      },
      "title": "Allowed Redirects",
      "type": "array"
    },
    "branch_outputs": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Branch Outputs",
      "type": "object"
    },
    "completion": {
      "$ref": "#/$defs/WorkflowCompletion"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "max_attempts_per_slot": {
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts Per Slot",
      "type": "integer"
    },
    "max_duration_seconds": {
      "maximum": 604800,
      "minimum": 1,
      "title": "Max Duration Seconds",
      "type": "integer"
    },
    "max_parallelism": {
      "maximum": 64,
      "minimum": 1,
      "title": "Max Parallelism",
      "type": "integer"
    },
    "max_repair_cycles": {
      "maximum": 10,
      "minimum": 0,
      "title": "Max Repair Cycles",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/OrchestratorPolicy"
    },
    "required_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Required Outputs",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/WorkflowStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "max_parallelism",
    "max_duration_seconds",
    "max_attempts_per_slot",
    "max_repair_cycles",
    "allowed_profiles",
    "completion",
    "required_outputs",
    "policy",
    "stages"
  ],
  "title": "WorkflowPreset",
  "type": "object"
}
