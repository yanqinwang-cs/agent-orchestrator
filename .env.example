# Proposed application settings, implemented in milestone 1.
# Copy to .env for development; the CLI loads it explicitly from the repository.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8765
ORCHESTRATOR_DATA_DIR=~/.local/share/agent-orchestrator
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_OPEN_BROWSER=true
ORCHESTRATOR_MAX_WORKERS=4
# Empty means use the SDK's pinned CLI package, not an arbitrary PATH version.
ORCHESTRATOR_CODEX_BIN=
# Isolated harness settings; authenticate through Codex itself when first needed.
ORCHESTRATOR_CODEX_HOME=~/.local/share/agent-orchestrator/codex
# No OpenAI API key is needed for Codex ChatGPT sign-in.
